# Neut — environment
#
# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> API
#
# Both values are safe to expose in the browser: the publishable/anon key only
# ever gets the access that row level security allows. Never put the service
# role ("secret") key or the database password in here — the app doesn't use
# them, and NEXT_PUBLIC_ values are bundled into the client.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
